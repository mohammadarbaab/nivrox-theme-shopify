{% doc %}
  @prompt
    A magazine-style editorial layout
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-magazine-layout-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-magazine-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    width: 100%;
  }

  .ai-magazine-hero-{{ ai_gen_id }} {
    grid-column: span 8;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-magazine-hero-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    aspect-ratio: {{ block.settings.hero_aspect_ratio }};
  }

  .ai-magazine-hero-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: {{ block.settings.hero_aspect_ratio }};
    position: relative;
  }

  .ai-magazine-hero-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-magazine-hero-content-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: {{ block.settings.content_padding }}px;
    background: linear-gradient(to top, {{ block.settings.overlay_color }}, transparent);
    color: {{ block.settings.text_color }};
  }

  .ai-magazine-hero-category-{{ ai_gen_id }} {
    font-size: {{ block.settings.category_size }}px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 8px;
    font-weight: 600;
    color: {{ block.settings.category_color }};
  }

  .ai-magazine-hero-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.hero_title_size }}px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 12px;
    color: {{ block.settings.text_color }};
  }

  .ai-magazine-hero-excerpt-{{ ai_gen_id }} {
    font-size: {{ block.settings.excerpt_size }}px;
    line-height: 1.5;
    margin: 0 0 16px;
    color: {{ block.settings.text_color }};
    opacity: 0.9;
  }

  .ai-magazine-hero-link-{{ ai_gen_id }} {
    display: inline-block;
    padding: 10px 24px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 14px;
    font-weight: 600;
    transition: background-color 0.3s ease;
  }

  .ai-magazine-hero-link-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-magazine-sidebar-{{ ai_gen_id }} {
    grid-column: span 4;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-magazine-card-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-magazine-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    aspect-ratio: {{ block.settings.card_aspect_ratio }};
  }

  .ai-magazine-card-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: {{ block.settings.card_aspect_ratio }};
  }

  .ai-magazine-card-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-magazine-card-content-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: {{ block.settings.card_padding }}px;
    background: linear-gradient(to top, {{ block.settings.overlay_color }}, transparent);
    color: {{ block.settings.text_color }};
  }

  .ai-magazine-card-category-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_category_size }}px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 6px;
    font-weight: 600;
    color: {{ block.settings.category_color }};
  }

  .ai-magazine-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
    color: {{ block.settings.text_color }};
  }

  .ai-magazine-card-link-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
  }

  .ai-magazine-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 4px;
    font-size: 12px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 989px) {
    .ai-magazine-hero-{{ ai_gen_id }} {
      grid-column: span 12;
    }

    .ai-magazine-sidebar-{{ ai_gen_id }} {
      grid-column: span 12;
      flex-direction: row;
    }

    .ai-magazine-card-{{ ai_gen_id }} {
      flex: 1;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-magazine-layout-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-magazine-sidebar-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-magazine-hero-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.hero_title_size | times: 0.7 }}px;
    }

    .ai-magazine-hero-content-{{ ai_gen_id }} {
      padding: {{ block.settings.content_padding | times: 0.7 }}px;
    }

    .ai-magazine-card-content-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.7 }}px;
    }
  }
{% endstyle %}

<magazine-editorial-{{ ai_gen_id }} class="ai-magazine-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-magazine-container-{{ ai_gen_id }}">
    <div class="ai-magazine-hero-{{ ai_gen_id }}">
      {% if block.settings.hero_image %}
        <img
          src="{{ block.settings.hero_image | image_url: width: 1200 }}"
          alt="{{ block.settings.hero_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.hero_image.width }}"
          height="{{ block.settings.hero_image.height }}"
          class="ai-magazine-hero-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-magazine-hero-placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
          <div class="ai-magazine-empty-state-{{ ai_gen_id }}">
            Add a hero image
          </div>
        </div>
      {% endif %}

      <div class="ai-magazine-hero-content-{{ ai_gen_id }}">
        {% if block.settings.hero_category != blank %}
          <div class="ai-magazine-hero-category-{{ ai_gen_id }}">{{ block.settings.hero_category }}</div>
        {% endif %}

        {% if block.settings.hero_title != blank %}
          <h2 class="ai-magazine-hero-title-{{ ai_gen_id }}">{{ block.settings.hero_title }}</h2>
        {% endif %}

        {% if block.settings.hero_excerpt != blank %}
          <div class="ai-magazine-hero-excerpt-{{ ai_gen_id }}">{{ block.settings.hero_excerpt }}</div>
        {% endif %}

        {% if block.settings.hero_link != blank and block.settings.hero_button_text != blank %}
          <a href="{{ block.settings.hero_link }}" class="ai-magazine-hero-link-{{ ai_gen_id }}">
            {{ block.settings.hero_button_text }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="ai-magazine-sidebar-{{ ai_gen_id }}">
      {% for i in (1..2) %}
        {% liquid
          assign card_image_key = 'card_' | append: i | append: '_image'
          assign card_category_key = 'card_' | append: i | append: '_category'
          assign card_title_key = 'card_' | append: i | append: '_title'
          assign card_link_key = 'card_' | append: i | append: '_link'

          assign card_image = block.settings[card_image_key]
          assign card_category = block.settings[card_category_key]
          assign card_title = block.settings[card_title_key]
          assign card_link = block.settings[card_link_key]
        %}

        <div class="ai-magazine-card-{{ ai_gen_id }}">
          {% if card_image %}
            <img
              src="{{ card_image | image_url: width: 600 }}"
              alt="{{ card_image.alt | escape }}"
              loading="lazy"
              width="{{ card_image.width }}"
              height="{{ card_image.height }}"
              class="ai-magazine-card-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-magazine-card-placeholder-{{ ai_gen_id }}">
              {{ 'collection-apparel-1' | placeholder_svg_tag }}
              <div class="ai-magazine-empty-state-{{ ai_gen_id }}">
                Add card {{ i }} image
              </div>
            </div>
          {% endif %}

          <div class="ai-magazine-card-content-{{ ai_gen_id }}">
            {% if card_category != blank %}
              <div class="ai-magazine-card-category-{{ ai_gen_id }}">{{ card_category }}</div>
            {% endif %}

            {% if card_title != blank %}
              <h3 class="ai-magazine-card-title-{{ ai_gen_id }}">{{ card_title }}</h3>
            {% endif %}
          </div>

          {% if card_link != blank %}
            <a href="{{ card_link }}" class="ai-magazine-card-link-{{ ai_gen_id }}" aria-label="{{ card_title | escape }}"></a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</magazine-editorial-{{ ai_gen_id }}>

<script>
  (function() {
    class MagazineEditorial{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAccessibility();
      }

      setupAccessibility() {
        const cards = this.querySelectorAll('.ai-magazine-card-{{ ai_gen_id }}');
        cards.forEach(card => {
          const link = card.querySelector('.ai-magazine-card-link-{{ ai_gen_id }}');
          if (link) {
            card.style.cursor = 'pointer';
          }
        });
      }
    }

    customElements.define('magazine-editorial-{{ ai_gen_id }}', MagazineEditorial{{ ai_gen_id }});
  })();
</script>

