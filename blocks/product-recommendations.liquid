

{%- doc -%}
  Renders product recommendations.
  {section.id} - identifies the parent section for the Section Rendering API

  https://shopify.dev/docs/api/section-rendering-api
{%- enddoc -%}

{% comment %}
PREMIUM LUXURY PRODUCT RECOMMENDATIONS
Shopify functionality preserved
Custom luxury frontend applied
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">

<script
  src="{{ 'product-recommendations.js' | asset_url }}"
  type="module"
></script>

<product-recommendations
  id="product-recommendations-{{ block.id }}"
  class="luxury-recommendations"
  data-url="{{ routes.product_recommendations_url }}?limit={{ block.settings.max_products }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ closest.product.id }}"
  data-intent="{{ block.settings.recommendation_type }}"
  data-recommendations-performed="{{ recommendations.performed }}"
  {{ block.shopify_attributes }}
>

<section class="featured-section">

    <div class="section-header">
        <div class="overline">— ÉDITION CURÉE —</div>
        <h2>Featured Selections</h2>
        <div class="subhead">
            Timeless silhouettes, modern elegance. Discover the new wave of luxury.
        </div>
    </div>

{% liquid
  assign products = recommendations.products

  if closest.product == blank
    assign products = collections.all.products
  endif
%}

<div class="products-grid">

{% for product in products limit: block.settings.max_products %}

<div class="product-card">

    <a href="{{ product.url }}" class="card-img">

        {% if product.featured_image %}
          <img
            src="{{ product.featured_image | image_url: width: 900 }}"
            alt="{{ product.title }}"
            loading="lazy"
            width=""
            height=""
          >
        {% endif %}

        <div class="badges">
            {% if product.available %}
              <span class="badge new">New Arrival</span>
            {% endif %}

            {% if product.compare_at_price > product.price %}
              <span class="badge bestseller">Best Seller</span>
            {% endif %}
        </div>

        <div class="wishlist">
            ♡
        </div>

    </a>

    <div class="card-info">

        <h3 class="product-title">
            <a href="{{ product.url }}">
              {{ product.title }}
            </a>
        </h3>

        {% if product.description != blank %}
        <p class="product-desc">
            {{ product.description | strip_html | truncate: 65 }}
        </p>
        {% endif %}

        <div class="rating">
            <span class="stars">★★★★★</span>
            <span class="rating-count">(24 reviews)</span>
        </div>

        <div class="price-wrapper">

            {% if product.compare_at_price > product.price %}
              <span class="old-price">
                {{ product.compare_at_price | money }}
              </span>
            {% endif %}

            <span class="sale-price">
              {{ product.price | money }}
            </span>

        </div>

        {% form 'product', product %}
          <input
            type="hidden"
            name="id"
            value="{{ product.selected_or_first_available_variant.id }}"
          >

          <button type="submit" class="btn-add">
              <span>Add to Cart</span>
          </button>
        {% endform %}

    </div>

</div>

{% endfor %}

</div>
</section>
</product-recommendations>
{% stylesheet %}

body{
  background:#F7F3EE;
}

/* SECTION */

.featured-section{
    max-width:1440px;
    margin:0 auto;
    padding:5rem 2rem 6rem;
}

/* HEADER */

.section-header{
    text-align:center;
    margin-bottom:3.5rem;
}

.overline{
    font-family:'Poppins',sans-serif;
    font-size:.78rem;
    letter-spacing:.25em;
    text-transform:uppercase;
    color:#9B8E7C;
    margin-bottom:1rem;
}

.section-header h2{
    font-family:'Playfair Display',serif;
    font-size:2.8rem;
    font-weight:500;
    color:#1E1B1A;
    letter-spacing:-0.03em;
}

.subhead{
    font-family:'Poppins',sans-serif;
    font-size:1rem;
    color:#6B625A;
    margin-top:1rem;
    font-weight:300;
}

/* GRID */

.products-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:2rem;
}

/* CARD */

.product-card{
    background:#fff;
    border-radius:28px;
    overflow:hidden;
    position:relative;
    transition:all .45s cubic-bezier(.22,1,.36,1);
    box-shadow:
      0 10px 25px rgba(0,0,0,.03),
      0 2px 5px rgba(0,0,0,.02);
}

.product-card:hover{
    transform:translateY(-8px);
    box-shadow:
      0 30px 40px rgba(0,0,0,.08),
      0 10px 15px rgba(0,0,0,.03);
}

/* IMAGE */

.card-img{
    position:relative;
    display:block;
    overflow:hidden;
    aspect-ratio:3/4;
    background:#EFE8DF;
}

.card-img img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:transform .8s ease;
}

.product-card:hover .card-img img{
    transform:scale(1.06);
}

/* BADGES */

.badges{
    position:absolute;
    top:1rem;
    left:1rem;
    z-index:3;
    display:flex;
    gap:.5rem;
}

.badge{
    padding:.45rem .85rem;
    border-radius:50px;
    font-size:.68rem;
    font-family:'Poppins';
    font-weight:500;
    letter-spacing:.04em;
    backdrop-filter:blur(8px);
}

.badge.new{
    background:#1E1B1A;
    color:#F7F3EE;
}

.badge.bestseller{
    background:rgba(255,255,255,.88);
    color:#1E1B1A;
}

/* WISHLIST */

.wishlist{
    position:absolute;
    top:1rem;
    right:1rem;
    width:38px;
    height:38px;
    border-radius:50%;
    background:rgba(255,255,255,.9);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:1rem;
    color:#7A6D60;
    transition:all .3s ease;
    backdrop-filter:blur(6px);
}

.wishlist:hover{
    background:#fff;
    transform:scale(1.08);
    color:#C47A6E;
}

/* INFO */

.card-info{
    padding:1.5rem 1.2rem 1.5rem;
}

.product-title{
    margin-bottom:.4rem;
}

.product-title a{
    text-decoration:none;
    color:#1E1B1A;
    font-family:'Playfair Display',serif;
    font-size:1.28rem;
    line-height:1.3;
    font-weight:500;
}

.product-desc{
    font-family:'Poppins';
    font-size:.78rem;
    line-height:1.5;
    color:#756D65;
    margin-bottom:.9rem;
}

/* RATING */

.rating{
    display:flex;
    align-items:center;
    gap:.4rem;
    margin-bottom:1rem;
}

.stars{
    color:#D8B75C;
    font-size:.72rem;
    letter-spacing:.1em;
}

.rating-count{
    font-size:.72rem;
    color:#9D9184;
}

/* PRICE */

.price-wrapper{
    display:flex;
    align-items:center;
    gap:.7rem;
    margin-bottom:1.3rem;
}

.old-price{
    color:#B0A69B;
    text-decoration:line-through;
    font-size:.9rem;
}

.sale-price{
    font-size:1.3rem;
    font-weight:600;
    color:#1E1B1A;
    font-family:'Poppins';
}

/* BUTTON */

.btn-add{
    width:100%;
    border:none;
    border-radius:999px;
    background:#1E1B1A;
    color:#F7F3EE;
    padding:.9rem 1rem;
    font-family:'Poppins';
    font-size:.82rem;
    letter-spacing:.06em;
    font-weight:500;
    cursor:pointer;
    transition:all .3s ease;
}

.btn-add:hover{
    background:#000;
    transform:scale(.985);
}

/* TABLET */

@media(max-width:1024px){

.products-grid{
    grid-template-columns:repeat(2,1fr);
}

}

/* MOBILE HORIZONTAL SLIDER */

@media(max-width:768px){

.featured-section{
    padding:3rem 1rem 4rem;
}

.section-header h2{
    font-size:2rem;
}

.products-grid{
    display:flex;
    overflow-x:auto;
    overflow-y:hidden;
    gap:1rem;
    scroll-snap-type:x mandatory;
    -webkit-overflow-scrolling:touch;
    padding-bottom:.5rem;
}

.products-grid::-webkit-scrollbar{
    height:4px;
}

.products-grid::-webkit-scrollbar-thumb{
    background:#CFC4B8;
    border-radius:999px;
}

.product-card{
    flex:0 0 84%;
    min-width:280px;
    scroll-snap-align:start;
}

.card-info{
    padding:1.2rem 1rem 1.3rem;
}

}

/* SMALL MOBILE */

@media(max-width:480px){

.product-card{
    flex:0 0 82%;
}

.section-header h2{
    font-size:1.8rem;
}

}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_recommendations",
  "class": "product-recommendations-wrapper",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_product_recommendations"
    },
    {
      "type": "select",
      "id": "recommendation_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "related",
          "label": "t:options.related"
        },
        {
          "value": "complementary",
          "label": "t:options.complementary"
        }
      ],
      "default": "related"
    },
    {
      "type": "paragraph",
      "content": "t:content.complementary_products"
    },
    {
      "type": "header",
      "content": "t:content.cards_layout"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.layout_style",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "carousel",
          "label": "t:options.carousel"
        }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "t:settings.carousel_on_mobile",
      "default": true,
      "visible_if": "{{ block.settings.layout_type == 'grid' }}"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:settings.product_count",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.layout_type == 'grid' or block.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "rows_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.layout_type == 'grid' }}"
    },
    {
      "type": "header",
      "content": "t:content.carousel_navigation",
      "visible_if": "{{ block.settings.layout_type == 'carousel' or block.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "t:settings.icon",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrows"
        },
        {
          "value": "chevron",
          "label": "t:options.chevrons"
        },
        {
          "value": "arrows_large",
          "label": "t:options.arrows_large"
        },
        {
          "value": "chevron_large",
          "label": "t:options.chevron_large"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "arrow",
      "visible_if": "{{ block.settings.layout_type == 'carousel' or block.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "t:settings.icon_background",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "circle",
          "label": "t:options.circle"
        },
        {
          "value": "square",
          "label": "t:options.square"
        }
      ],
      "default": "none",
      "visible_if": "{{ block.settings.icons_style != 'none' and block.settings.layout_type == 'carousel' or block.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.product_recommendations",
      "category": "t:categories.product",
      "settings": {
        "recommendation_type": "related",
        "border_radius": 0,
        "padding-inline-start": 0,
        "padding-inline-end": 0
      },
      "blocks": {
        "heading": {
          "type": "text",
          "settings": {
            "text": "t:html_defaults.may_also_like"
          }
        },
        "static-product-card": {
          "type": "_product-card",
          "static": true,
          "settings": {
            "product_card_gap": 4
          },
          "blocks": {
            "product-card-gallery": {
              "type": "_product-card-gallery",
              "settings": {
                "image_ratio": "adapt",
                "border": "none",
                "border_width": 1,
                "border_opacity": 100,
                "border_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "product_title": {
              "type": "product-title",
              "name": "t:names.product_title",
              "settings": {
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "rte",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "color": "var(--color-foreground)",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 4,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "price": {
              "type": "price",
              "name": "t:names.product_price",
              "settings": {
                "show_sale_price_first": true,
                "show_installments": false,
                "show_tax_info": false,
                "type_preset": "h6",
                "width": "100%",
                "alignment": "left",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "color": "var(--color-foreground)",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            }
          },
          "block_order": ["product-card-gallery", "product_title", "price"]
        }
      },
      "block_order": ["heading"]
    }
  ]
}
{% endschema %}
