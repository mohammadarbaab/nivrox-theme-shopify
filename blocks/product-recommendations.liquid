{% comment %}
Luxury Product Recommendations - FULL SECTION (COS / ÉCLAT STYLE)
{% endcomment %}

<script src="{{ 'product-recommendations.js' | asset_url }}" type="module"></script>

<style>
/* ===========================
   BASE LUXURY STYLING
=========================== */

.featured-section {
    max-width: 1440px;
    margin: 0 auto;
    padding: 5rem 2rem 6rem;
    font-family: 'Poppins', sans-serif;
    color: #1E1B1A;
    background: #F7F3EE;
    position: relative;
}

.featured-section:before {
    content: '';
    display: block;
    width: 70px;
    height: 2px;
    background: #DCCFC2;
    margin: 0 auto 2rem auto;
    border-radius: 2px;
}

/* ===========================
   HEADER
=========================== */

.section-header {
    text-align: center;
    margin-bottom: 3.5rem;
}

.section-header .overline {
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9B8E7C;
    margin-bottom: 1rem;
}

.section-header h2 {
    font-family: 'Playfair Display', serif;
    font-size: 2.6rem;
    font-weight: 500;
}

.subhead {
    font-size: 1rem;
    color: #5A5249;
    max-width: 500px;
    margin: 1rem auto 0;
    font-weight: 300;
}

/* ===========================
   GRID LAYOUT
=========================== */

.products-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
}

/* ===========================
   PRODUCT CARD
=========================== */

.product-card {
    background: #FFFFFF;
    border-radius: 24px;
    overflow: hidden;
    position: relative;
    transition: all 0.4s cubic-bezier(0.2, 0, 0, 1);
    box-shadow: 0 8px 20px rgba(0,0,0,0.02);
}

.product-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 25px 35px -12px rgba(0,0,0,0.12);
}

/* ===========================
   IMAGE
=========================== */

.card-img {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: #F0EBE4;
}

.card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
}

.product-card:hover .card-img img {
    transform: scale(1.05);
}

/* ===========================
   BADGES
=========================== */

.badges {
    position: absolute;
    top: 1rem;
    left: 1rem;
    display: flex;
    gap: 0.5rem;
}

.badge {
    font-size: 0.7rem;
    padding: 4px 10px;
    border-radius: 20px;
    background: rgba(255,255,255,0.9);
    backdrop-filter: blur(4px);
}

.badge.new {
    background: #1E1B1A;
    color: #F7F3EE;
}

.badge.bestseller {
    background: #E6DED5;
}

/* ===========================
   WISHLIST
=========================== */

.wishlist {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255,255,255,0.85);
    display:flex;
    align-items:center;
    justify-content:center;
    cursor:pointer;
}

/* ===========================
   CONTENT
=========================== */

.card-info {
    padding: 1.5rem;
}

.product-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.25rem;
    margin-bottom: 0.4rem;
}

.product-desc {
    font-size: 0.75rem;
    color: #6F675F;
    margin-bottom: 0.8rem;
}

/* ===========================
   PRICE
=========================== */

.price-wrapper {
    display: flex;
    gap: 0.7rem;
    align-items: baseline;
    margin-bottom: 1.2rem;
}

.old-price {
    text-decoration: line-through;
    color: #A99F94;
    font-size: 0.85rem;
}

.sale-price {
    font-size: 1.3rem;
    font-weight: 600;
}

/* ===========================
   BUTTON
=========================== */

.btn-add {
    width: 100%;
    background: #1E1B1A;
    color: #F7F3EE;
    border: none;
    padding: 0.85rem;
    border-radius: 60px;
    cursor: pointer;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    transition: 0.3s ease;
}

.btn-add:hover {
    background: #000;
    transform: scale(0.98);
}

/* ===========================
   MOBILE SWIPE
=========================== */

@media(max-width:768px){

.products-grid{
    display:flex;
    overflow-x:auto;
    gap:1.2rem;
    scroll-snap-type:x mandatory;
    -webkit-overflow-scrolling:touch;
}

.product-card{
    flex:0 0 85%;
    min-width:260px;
    scroll-snap-align:start;
}

.section-header h2{
    font-size:2rem;
}

}

</style>

<product-recommendations
  class="featured-section"
  data-url="{{ routes.product_recommendations_url }}?limit={{ section.settings.max_products }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-intent="{{ section.settings.recommendation_type }}"
>

  <!-- HEADER -->
  <div class="section-header">
      <div class="overline">— ÉDITION CURÉE —</div>
      <h2>Featured Selections</h2>
      <div class="subhead">
          Timeless silhouettes, modern elegance. You may also like these selections.
      </div>
  </div>

  {% if recommendations.performed and recommendations.products_count > 0 %}

  <div class="products-grid">

      {% for product in recommendations.products limit: section.settings.max_products %}

      <div class="product-card">

          <div class="card-img">
              <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title }}">

              <div class="badges">
                  {% if product.tags contains 'new' %}
                      <span class="badge new">New</span>
                  {% endif %}
                  {% if product.tags contains 'bestseller' %}
                      <span class="badge bestseller">Best Seller</span>
                  {% endif %}
              </div>

              <div class="wishlist">
                  <i class="far fa-heart"></i>
              </div>
          </div>

          <div class="card-info">

              <h3 class="product-title">{{ product.title }}</h3>

              <p class="product-desc">
                  {{ product.description | strip_html | truncate: 65 }}
              </p>

              <div class="price-wrapper">
                  {% if product.compare_at_price > product.price %}
                      <span class="old-price">{{ product.compare_at_price | money }}</span>
                  {% endif %}
                  <span class="sale-price">{{ product.price | money }}</span>
              </div>

              <form method="post" action="/cart/add">
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  <button type="submit" class="btn-add">
                      Add to Cart
                  </button>
              </form>

          </div>

      </div>

      {% endfor %}

  </div>

  {% else %}

  <div class="products-grid">
      {% for i in (1..4) %}
          <div class="product-card" style="height:420px;"></div>
      {% endfor %}
  </div>

  {% endif %}

</product-recommendations>

<script>
// Wishlist toggle
document.querySelectorAll('.wishlist').forEach(el=>{
    el.addEventListener('click', ()=>{
        const icon = el.querySelector('i');
        icon.classList.toggle('far');
        icon.classList.toggle('fas');
    });
});
</script>

{% schema %}
{
  "name": "Luxury",
  "settings": [
    {
      "type": "select",
      "id": "recommendation_type",
      "label": "Type",
      "options": [
        {"value": "related", "label": "Related"},
        {"value": "complementary", "label": "Complementary"}
      ],
      "default": "related"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Products",
      "min": 2,
      "max": 10,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Luxury Product Recommendations"
    }
  ]
}
{% endschema %}