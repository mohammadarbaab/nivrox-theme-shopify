

{%- doc -%}
  Renders product recommendations.
  {section.id} - identifies the parent section for the Section Rendering API

  https://shopify.dev/docs/api/section-rendering-api
{%- enddoc -%}

<script
  src="{{ 'product-recommendations.js' | asset_url }}"
  type="module"
></script>

{% liquid
  assign block_settings = block.settings
  case block_settings.layout_type
    when 'grid'
      assign classes = 'resource-list--grid'
    when 'carousel'
      assign classes = 'resource-list--carousel'
  endcase
%}

<style>
/* ====== YOUR ORIGINAL CSS (UNCHANGED) ====== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background-color: #F7F3EE;
    font-family: 'Poppins', sans-serif;
    color: #1E1B1A;
    scroll-behavior: smooth;
}

.featured-section {
    max-width: 1440px;
    margin: 0 auto;
    padding: 5rem 2rem 6rem;
    position: relative;
}

.featured-section:before {
    content: '';
    display: block;
    width: 70px;
    height: 2px;
    background: #DCCFC2;
    margin: 0 auto 2rem auto;
    border-radius: 2px;
}

.section-header {
    text-align: center;
    margin-bottom: 3.5rem;
}

.section-header .overline {
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9B8E7C;
    margin-bottom: 1rem;
}

.section-header h2 {
    font-family: 'Playfair Display', serif;
    font-size: 2.6rem;
}

.section-header .subhead {
    font-size: 1rem;
    color: #5A5249;
    max-width: 500px;
    margin: 1rem auto 0;
}

.products-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
}

.product-card {
    background: #fff;
    border-radius: 24px;
    overflow: hidden;
    transition: all 0.4s ease;
    box-shadow: 0 8px 20px rgba(0,0,0,0.02);
}

.product-card:hover {
    transform: translateY(-6px);
}

.card-img {
    position: relative;
    aspect-ratio: 3/4;
    background: #F0EBE4;
    overflow: hidden;
}

.card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
}

.product-card:hover .card-img img {
    transform: scale(1.05);
}

.card-info {
    padding: 1.5rem;
}

.product-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.25rem;
}

.product-desc {
    font-size: 0.75rem;
    color: #6F675F;
    margin: 0.5rem 0;
}

.price-wrapper {
    display: flex;
    gap: 10px;
    align-items: baseline;
    margin: 1rem 0;
}

.old-price {
    text-decoration: line-through;
    color: #A99F94;
}

.sale-price {
    font-size: 1.3rem;
    font-weight: 600;
}

.btn-add {
    width: 100%;
    background: #1E1B1A;
    color: #F7F3EE;
    border: none;
    padding: 0.85rem;
    border-radius: 60px;
    cursor: pointer;
    transition: 0.3s;
}

.btn-add:hover {
    background: #000;
}

.wishlist {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(255,255,255,0.85);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display:flex;
    align-items:center;
    justify-content:center;
    cursor:pointer;
}

.badges {
    position: absolute;
    top: 1rem;
    left: 1rem;
    display:flex;
    gap:0.5rem;
}

.badge {
    font-size: 0.7rem;
    padding: 4px 10px;
    border-radius: 20px;
    background: white;
}

/* MOBILE */
@media(max-width:768px){
    .products-grid{
        display:flex;
        overflow-x:auto;
        gap:1rem;
        scroll-snap-type:x mandatory;
    }
    .product-card{
        min-width:85%;
    }
}
</style>

<section class="featured-section">

    <div class="section-header">
        <div class="overline">— ÉDITION CURÉE —</div>
        <h2>{{ section.settings.heading }}</h2>
        <div class="subhead">{{ section.settings.subheading }}</div>
    </div>

    <div class="products-grid">

        {% for product in section.settings.collection.products limit: 4 %}

        <div class="product-card">

            <div class="card-img">
                <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title }}">

                <div class="badges">
                    {% if product.tags contains 'new' %}
                        <span class="badge">New Arrival</span>
                    {% endif %}
                    {% if product.tags contains 'bestseller' %}
                        <span class="badge">Best Seller</span>
                    {% endif %}
                </div>

                <div class="wishlist">
                    <i class="far fa-heart"></i>
                </div>
            </div>

            <div class="card-info">

                <h3 class="product-title">{{ product.title }}</h3>

                <p class="product-desc">
                    {{ product.description | strip_html | truncate: 60 }}
                </p>

                <div class="price-wrapper">
                    {% if product.compare_at_price > product.price %}
                        <span class="old-price">{{ product.compare_at_price | money }}</span>
                    {% endif %}
                    <span class="sale-price">{{ product.price | money }}</span>
                </div>

                <!-- ADD TO CART (SHOPIFY REAL FUNCTIONAL) -->
                <form method="post" action="/cart/add">
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                    <button type="submit" class="btn-add">
                        <i class="fas fa-shopping-bag"></i> Add to Cart
                    </button>
                </form>

            </div>

        </div>

        {% endfor %}

    </div>
</section>

<script>
// Wishlist toggle (same UX)
document.querySelectorAll('.wishlist').forEach(el=>{
    el.addEventListener('click', ()=>{
        const icon = el.querySelector('i');
        icon.classList.toggle('fas');
        icon.classList.toggle('far');
    });
});
</script>

{% schema %}
{
  "name": "Featured Luxury Products",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Selections"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Timeless silhouettes, modern elegance. Discover the new wave of luxury."
    }
  ],
  "presets": [
    {
      "name": "Featured Luxury Products"
    }
  ]
}
{% endschema %}