{% comment %} 

{%- capture children %}
  {% content_for 'blocks' %}
{% endcapture %}

{% render 'group', children: children, settings: block.settings, shopify_attributes: block.shopify_attributes %}

{% stylesheet %}
  /*====================================================
  PREMIUM GROUP BLOCK RESPONSIVE (HORIZONTAL SAFE)
=====================================================*/

*,
*::before,
*::after {
  box-sizing: border-box;
}

.group,
.group-block,
.group-wrapper {
  width: 100%;
  max-width: 100%;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-start;
  gap: var(--gap, 16px);
  overflow: hidden;
  border-radius: var(--border-radius, 14px);
  transition: all 0.3s ease;
}

/*========================
  FORCE HORIZONTAL FLOW (DESKTOP)
=========================*/

.group--row,
.content-direction-row {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap; /* IMPORTANT → keeps single row */
  align-items: center;
  justify-content: flex-start;
  gap: var(--gap, 16px);
  overflow-x: auto; /* allows scroll instead of breaking */
  -webkit-overflow-scrolling: touch;
  scroll-snap-type: x mandatory;
}

/* Hide scrollbar (clean UI) */
.group--row::-webkit-scrollbar {
  display: none;
}

/*========================
  CHILD ELEMENTS (CARD STYLE ALIGNMENT)
=========================*/

.group > *,
.group-block > *,
.group-wrapper > * {
  flex: 0 0 auto;
  min-width: 140px;
  max-width: 100%;
  scroll-snap-align: start;
}

/*========================
  ICON + TEXT ALIGNMENT FIX
=========================*/

.group svg,
.group img {
  width: 100%;
  max-width: 100%;
  height: auto;
  display: block;
  object-fit: contain;
}

.group .icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

/*========================
  TYPOGRAPHY (RESPONSIVE BUT STABLE)
=========================*/

.group h1,
.group h2,
.group h3,
.group h4 {
  margin: 0;
  font-weight: 700;
  line-height: 1.3;
  color: #111;
  word-break: break-word;
}

.group h1 { font-size: clamp(26px, 4vw, 48px); }
.group h2 { font-size: clamp(22px, 3vw, 36px); }
.group h3 { font-size: clamp(18px, 2.5vw, 28px); }

.group p,
.group span,
.group li {
  font-size: clamp(13px, 1.8vw, 15px);
  line-height: 1.6;
  color: #555;
}

/*========================
  BUTTONS (SMART RESPONSIVE)
=========================*/

.group button,
.group .button,
.group .btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-height: 46px;
  padding: 12px 18px;

  border-radius: 10px;
  border: none;

  background: #000;
  color: #fff;

  font-weight: 600;
  font-size: 14px;

  cursor: pointer;
  transition: 0.3s ease;
  white-space: nowrap;
}

.group button:hover,
.group .button:hover {
  transform: translateY(-2px);
  background: #222;
}

/*========================
  MOBILE: HORIZONTAL SCROLL (NO BREAK)
=========================*/

@media (max-width: 768px) {

  .group--row,
  .content-direction-row {
    flex-wrap: nowrap;
    overflow-x: auto;
    gap: 12px;
    padding-bottom: 6px;
  }

  .group > *,
  .group-block > *,
  .group-wrapper > * {
    min-width: 180px; /* better touch UX */
  }

  /* Text slightly smaller for mobile */
  .group h1 { font-size: 24px; }
  .group h2 { font-size: 20px; }
  .group h3 { font-size: 18px; }

  .group button {
    min-height: 44px;
    font-size: 13px;
  }
}

/*========================
  SMALL MOBILE (STILL HORIZONTAL)
=========================*/

@media (max-width: 480px) {

  .group > *,
  .group-block > *,
  .group-wrapper > * {
    min-width: 160px;
  }

  .group p,
  .group span {
    font-size: 13px;
  }
}

/*========================
  ANTI OVERFLOW SAFETY
=========================*/

.group,
.group-block,
.group-wrapper {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

body {
  overflow-x: hidden;
}{% endstylesheet %}
