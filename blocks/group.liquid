

{%- capture children %}
  {% content_for 'blocks' %}
{% endcapture %}

{% render 'group', children: children, settings: block.settings, shopify_attributes: block.shopify_attributes %}

{% stylesheet %}
  /*====================================================
  SHOPIFY GROUP BLOCK - PREMIUM RESPONSIVE CSS
=====================================================*/

/*========================
  GLOBAL RESET
=========================*/

*,
*::before,
*::after {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
  overflow-x: hidden;
  width: 100%;
  max-width: 100%;
  scroll-behavior: smooth;
  font-family: Arial, sans-serif;
}

/* Prevent all overflow */

body * {
  max-width: 100%;
}

/*========================
  MAIN GROUP CONTAINER
=========================*/

.group,
.group-block,
.group-wrapper {
  position: relative;

  width: 100%;
  max-width: 100%;

  display: flex;
  flex-direction: column;

  overflow: hidden;

  transition: all 0.3s ease;
}

/*========================
  FLEX ROW LAYOUT
=========================*/

.group--row,
.content-direction-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;

  gap: var(--gap, 16px);

  align-items: center;
}

/*========================
  FLEX COLUMN LAYOUT
=========================*/

.group--column,
.content-direction-column {
  display: flex;
  flex-direction: column;

  gap: var(--gap, 16px);
}

/*========================
  CHILD ELEMENTS
=========================*/

.group > *,
.group-block > *,
.group-wrapper > * {
  max-width: 100%;
  min-width: 0;
}

/*========================
  RESPONSIVE IMAGES
=========================*/

.group img,
.group video,
.group iframe,
.group svg {
  width: 100%;
  max-width: 100%;
  height: auto;

  display: block;

  border-radius: inherit;

  object-fit: cover;
}

/* Smooth hover effect */

.group img {
  transition: transform 0.4s ease;
}

.group img:hover {
  transform: scale(1.02);
}

/*========================
  TYPOGRAPHY
=========================*/

.group h1,
.group h2,
.group h3,
.group h4,
.group h5,
.group h6 {
  margin: 0;

  line-height: 1.3;
  font-weight: 700;

  word-break: break-word;

  color: #111;
}

.group h1 {
  font-size: clamp(28px, 5vw, 52px);
}

.group h2 {
  font-size: clamp(24px, 4vw, 42px);
}

.group h3 {
  font-size: clamp(20px, 3vw, 34px);
}

.group p,
.group span,
.group li,
.group a {
  font-size: clamp(14px, 2vw, 16px);

  line-height: 1.7;

  color: #555;

  word-break: break-word;
}

/*========================
  BUTTONS
=========================*/

.group button,
.group .button,
.group .btn,
.group input[type="submit"] {
  width: auto;
  min-height: 50px;

  padding: 14px 22px;

  border: none;
  border-radius: 12px;

  background: #000;
  color: #fff;

  font-size: clamp(14px, 2vw, 16px);
  font-weight: 600;

  cursor: pointer;

  transition: all 0.3s ease;

  text-align: center;

  white-space: normal;
  word-break: break-word;
}

/* Hover */

.group button:hover,
.group .button:hover,
.group .btn:hover,
.group input[type="submit"]:hover {
  background: #222;
  transform: translateY(-2px);
}

/*========================
  LINKS
=========================*/

.group a {
  text-decoration: none;
  transition: 0.3s ease;
}

.group a:hover {
  opacity: 0.8;
}

/*========================
  FORMS
=========================*/

.group input,
.group textarea,
.group select {
  width: 100%;

  min-height: 48px;

  padding: 12px 14px;

  border: 1px solid #ddd;
  border-radius: 10px;

  font-size: 15px;

  outline: none;
}

.group textarea {
  min-height: 120px;
  resize: vertical;
}

/*========================
  VIDEO / BACKGROUND MEDIA
=========================*/

.group video,
.group iframe {
  border-radius: inherit;
  overflow: hidden;
}

/*========================
  BORDER + SHADOW
=========================*/

.group {
  border-radius: var(--border-radius, 14px);
}

/* Optional classy shadow */

.group.shadow {
  box-shadow:
    0 4px 14px rgba(0,0,0,0.06),
    0 10px 30px rgba(0,0,0,0.04);
}

/*========================
  TABLET RESPONSIVE
=========================*/

@media screen and (max-width: 991px) {

  .group,
  .group-block,
  .group-wrapper {
    width: 100%;
  }

  .group--row,
  .content-direction-row {
    gap: 18px;
  }

  .group h1 {
    font-size: 36px;
  }

  .group h2 {
    font-size: 30px;
  }

  .group h3 {
    font-size: 24px;
  }
}

/*========================
  MOBILE RESPONSIVE
=========================*/

@media screen and (max-width: 767px) {

  html,
  body {
    overflow-x: hidden !important;
  }

  /* FORCE MOBILE STACK */

  .group--row,
  .content-direction-row {
    flex-direction: column !important;
    align-items: stretch !important;
  }

  /* Full Width Mobile */

  .group,
  .group-block,
  .group-wrapper {
    width: 100%;
    max-width: 100%;
  }

  /* Mobile Typography */

  .group h1 {
    font-size: 30px;
    line-height: 1.3;
  }

  .group h2 {
    font-size: 26px;
  }

  .group h3 {
    font-size: 22px;
  }

  .group p,
  .group span,
  .group li,
  .group a {
    font-size: 14px;
    line-height: 1.7;
  }

  /* Mobile Buttons */

  .group button,
  .group .button,
  .group .btn,
  .group input[type="submit"] {
    width: 100%;
    min-height: 48px;

    font-size: 14px;

    border-radius: 10px;
  }

  /* Mobile Inputs */

  .group input,
  .group textarea,
  .group select {
    font-size: 14px;
  }

  /* Prevent any overflow */

  .group *,
  .group-block *,
  .group-wrapper * {
    max-width: 100%;
  }
}

/*========================
  EXTRA SMALL MOBILE
=========================*/

@media screen and (max-width: 480px) {

  .group h1 {
    font-size: 26px;
  }

  .group h2 {
    font-size: 22px;
  }

  .group h3 {
    font-size: 19px;
  }

  .group p,
  .group span,
  .group li,
  .group a {
    font-size: 13px;
  }

  .group button,
  .group .button,
  .group .btn,
  .group input[type="submit"] {
    min-height: 46px;

    font-size: 13px;

    padding: 12px;
  }
}
{% endstylesheet %}
{% schema %}
{
  "name": "t:names.group",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        },
        {
          "value": "row",
          "label": "t:options.horizontal"
        }
      ],
      "default": "column"
    },
    {
      "type": "checkbox",
      "id": "vertical_on_mobile",
      "label": "t:settings.vertical_on_mobile",
      "default": true,
      "visible_if": "{{ block.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        },
        {
          "value": "space-between",
          "label": "t:options.space_between"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ block.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "t:settings.position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.content_direction == 'row' }}"
    },
    {
      "type": "checkbox",
      "id": "align_baseline",
      "label": "t:settings.align_baseline",
      "default": false,
      "visible_if": "{{ block.settings.vertical_alignment == 'flex-end' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment_flex_direction_column",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ block.settings.content_direction != 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment_flex_direction_column",
      "label": "t:settings.position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        },
        {
          "value": "space-between",
          "label": "t:options.space_between"
        }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.content_direction == 'column' }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
