    <div class="icon">🔥</div>
    <h4>Fast Delivery</h4>
    <p>2–3 days shipping</p>
  </div>

  <div class="swipe-card">
    <div class="icon">📦</div>
    <h4>Easy Returns</h4>
    <p>30 day return policy</p>
  </div>

  <div class="swipe-card">
    <div class="icon">⚡</div>
    <h4>High Demand</h4>
    <p>Limited stock left</p>
  </div>

</div>

<style>
  /*========================
  SWIPE CONTAINER (HORIZONTAL SCROLL)
=========================*/

.swipe-container {
  display: flex;
  flex-wrap: nowrap;
  overflow-x: auto;
  gap: 14px;

  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;

  padding: 10px 4px;
}

/* Hide scrollbar (clean Apple look) */
.swipe-container::-webkit-scrollbar {
  display: none;
}

/*========================
  SWIPE CARDS (MAIN UX)
=========================*/

.swipe-card {
  flex: 0 0 auto;

  width: 78%;
  max-width: 260px;

  scroll-snap-align: center;

  background: #fff;
  border: 1px solid rgba(0,0,0,0.08);
  border-radius: 16px;

  padding: 16px;

  display: flex;
  flex-direction: column;
  gap: 6px;

  box-shadow:
    0 6px 18px rgba(0,0,0,0.06);

  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

/* Hover (desktop feel) */
.swipe-card:hover {
  transform: translateY(-4px);
  box-shadow:
    0 10px 25px rgba(0,0,0,0.10);
}

/*========================
  ICON STYLE
=========================*/

.swipe-card .icon {
  font-size: 22px;
  width: 40px;
  height: 40px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 10px;
  background: rgba(0,0,0,0.04);
}

/*========================
  TEXT STYLE (APPLE FEEL)
=========================*/

.swipe-card h4 {
  margin: 0;
  font-size: 15px;
  font-weight: 700;
  color: #111;
}

.swipe-card p {
  margin: 0;
  font-size: 13px;
  color: #666;
  line-height: 1.4;
}

/*========================
  MOBILE OPTIMIZED UX
=========================*/

@media (max-width: 768px) {

  .swipe-card {
    width: 82%;
    max-width: 280px;
  }

  .swipe-container {
    gap: 12px;
    padding-left: 12px;
  }
}

/*========================
  EXTRA SMOOTH TOUCH UX
=========================*/

.swipe-container {
  scroll-behavior: smooth;
}
</style>

