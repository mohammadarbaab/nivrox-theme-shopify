<product-card
  class="product-card custom-product-card"
  data-product-id="{{ product.id }}"
  id="product-card-{{ block.id }}"
  {{ block.shopify_attributes }}
>

  <div class="custom-product-card-inner">

    <!-- IMAGE -->
    <div class="custom-product-image-wrapper">

      <a
        href="{{ product.url }}"
        class="custom-product-image-link"
      >

        {% if product.featured_image %}
          <img
            src="{{ product.featured_image | image_url: width: 600 }}"
            alt="{{ product.title | escape }}"
            class="custom-product-image"
            loading="lazy"
            width="600"
            height="600"
          >
        {% endif %}

      </a>

      {% comment %} <!-- ADD TO CART -->
      {% if product.available %}
        <div class="custom-add-to-cart">

          <form method="post" action="/cart/add">

            <input
              type="hidden"
              name="id"
              value="{{ product.selected_or_first_available_variant.id }}"
            >

            <button type="submit" class="custom-add-btn">
              Add To Cart
            </button>

          </form>

        </div>
      {% endif %} {% endcomment %}

    </div>

    <!-- INFO -->
    <div class="custom-product-info">

      <h3 class="custom-product-title">
        <a href="{{ product.url }}">
          {{ product.title }}
        </a>
      </h3>

      <div class="custom-product-price">

        {% if product.compare_at_price > product.price %}

          <span class="compare-price">
            {{ product.compare_at_price | money }}
          </span>

          <span class="sale-price">
            {{ product.price | money }}
          </span>

        {% else %}

          <span class="regular-price">
            {{ product.price | money }}
          </span>

        {% endif %}

      </div>

    </div>

  </div>

</product-card>

{% stylesheet %}

.custom-product-card{
  width:100%;;
}

.custom-product-card-inner{
  border-radius:20px;
  overflow:hidden;
  border:1px solid gray;
  height:100%;
}

.custom-product-image-wrapper{
  position:relative;
  overflow:hidden;
  aspect-ratio:3/4;
  background:#F7F3EE;
}

.custom-product-image-link{
  display:block;
}

.custom-product-image{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
}

.custom-add-to-cart{
  position:absolute;
  left:0;
  right:0;
  bottom:0;
  padding:15px;
}

.custom-add-btn{
  width:100%;
  border:none;
  background:#111;
  color:#fff;
  padding:14px;
  border-radius:12px;
  font-size:14px;
  cursor:pointer;
}

.custom-add-btn:hover{
  background:#C7A14A;
}

.custom-product-info{
  padding:18px;
}

.custom-product-title{
  font-size:18px;
  margin-bottom:10px;
  line-height:1.4;
}

.custom-product-title a{
  text-decoration:none;
  color:#111;
}

.custom-product-title a:hover{
  color:#C7A14A;
}

.custom-product-price{
  display:flex;
  gap:10px;
  align-items:center;
  flex-wrap:wrap;
}

.compare-price{
  text-decoration:line-through;
  color:#999;
  font-size:14px;
}

.sale-price{
  color:red;
  font-weight:600;
}

.regular-price{
  font-weight:600;
  color:#111;
}

@media(max-width:767px){

  .custom-product-info{
    padding:12px;
  }

  .custom-product-title{
    font-size:13px;
  }

  .custom-add-btn{
    padding:10px;
    font-size:12px;
  }

}


{% endstylesheet %}