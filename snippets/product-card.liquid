{%- if settings.transition_to_main_product -%}
  <product-card-link
    data-product-id="{{ product.id }}"
    data-featured-media-url="{{ featured_media_url }}"
    data-product-transition="{{ settings.transition_to_main_product }}"
    {% if onboarding %}
      data-placeholder="true"
    {% endif %}
  >
{%- endif -%}

<product-card
  class="product-card custom-product-card"
  data-product-id="{{ product.id }}"
  id="product-card-{{ block.id }}"
  data-product-transition="{{ settings.transition_to_main_product }}"
  {{ block.shopify_attributes }}
>

  <div class="custom-product-card-inner">

    <!-- IMAGE -->
    <div class="custom-product-image-wrapper">

      <a
        {% unless onboarding %}
          href="{{ variant_to_link.url }}"
        {% endunless %}
        class="custom-product-image-link"
      >

        {% if product.featured_image %}
          <img
            src="{{ product.featured_image | image_url: width: 600 }}"
            alt="{{ product.title }}"
            class="custom-product-image"
            loading="lazy"
            width="600"
            height="600"
          >
        {% endif %}

      </a>

      <!-- ADD TO CART -->
      {% comment %} {% if product.available %}
        <div class="custom-add-to-cart">
          <form method="post" action="/cart/add">
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

            <button type="submit" class="custom-add-btn">
              Add To Cart
            </button>
          </form>
        </div>
      {% endif %} {% endcomment %}

    </div>

    <!-- INFO -->
    <div class="custom-product-info">

      <h3 class="custom-product-title">
        <a href="{{ variant_to_link.url }}">
          {{ product.title }}
        </a>
      </h3>

      <div class="custom-product-price">
        {% if product.compare_at_price > product.price %}
          <span class="compare-price">
            {{ product.compare_at_price | money }}
          </span>

          <span class="sale-price">
            {{ product.price | money }}
          </span>

        {% else %}

          <span class="regular-price">
            {{ product.price | money }}
          </span>

        {% endif %}
      </div>

    </div>

  </div>

</product-card>

{%- if settings.transition_to_main_product -%}
  </product-card-link>
{%- endif -%}

{% stylesheet %}

.custom-product-card-inner{
  /* background:green; */
  border-radius:20px;
  overflow:hidden;
  border:1px solid #eee;
  /* transition:.4s; */
  height:100%;
}


.custom-product-card-inner:hover{
  /* transform:translateY(-8px);
  box-shadow:0 20px 40px rgba(0,0,0,.12); */
}

.custom-product-image-wrapper{
  position:relative;
  overflow:hidden;
  aspect-ratio:3/4;
  background:blue;
}

.custom-product-image{
  width:100%;
  height:100%;
  object-fit:cover;
  /* transition:.6s; */
}

.custom-product-card-inner:hover .custom-product-image{
  /* transform:scale(1.08); */
}

.custom-add-to-cart{
  position:absolute;
  left:0;
  right:0;
  bottom:0;
  padding:15px;
  /* transform:translateY(100%);
  transition:.4s; */
}

.custom-product-card-inner:hover .custom-add-to-cart{
  /* transform:translateY(0); */
}

.custom-add-btn{
  width:100%;
  border:none;
  background:#111;
  color:#fff;
  padding:14px;
  border-radius:12px;
  font-size:14px;
  cursor:pointer;
}

.custom-add-btn:hover{
  background:#C7A14A;
}

.custom-product-info{
  padding:18px;
}

.custom-product-title{
  font-size:18px;
  margin-bottom:10px;
}

.custom-product-title a{
  text-decoration:none;
  color:#111;
}

.custom-product-title a:hover{
  color:#C7A14A;
}

.custom-product-price{
  display:flex;
  gap:10px;
  align-items:center;
}

.compare-price{
  text-decoration:line-through;
  color:#999;
}

.sale-price{
  color:red;
  font-weight:600;
}

.regular-price{
  font-weight:600;
  color:#111;
}

@media(max-width:767px){

  .custom-product-info{
    padding:12px;
  }

  .custom-product-title{
    font-size:13px;
  }

  .custom-add-btn{
    padding:10px;
    font-size:12px;
  }

}

{% endstylesheet %}