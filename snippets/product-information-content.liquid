=========================*/

.product-information__grid {
  width: 100%;
  max-width: 1300px;
  margin: 0 auto;

  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 50px;

  align-items: start;
}

/*========================
  PRODUCT IMAGE SECTION
=========================*/

.product-information__media {
  width: 100%;
  border-radius: 14px;
  overflow: hidden;
  background: #fff;
  position: relative;
}

/* Product Images */

.product-information__media img {
  width: 100%;
  height: auto;
  object-fit: cover;
  border-radius: 14px;
  transition: transform 0.4s ease;
}

/* Smooth Hover Effect */

.product-information__media img:hover {
  transform: scale(1.02);
}

/*========================
  PRODUCT DETAILS SECTION
=========================*/

.product-details {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 22px;

  overflow: hidden;
}

/*========================
  PRODUCT TITLE
=========================*/

.product-details h1 {
  font-size: clamp(24px, 4vw, 42px);
  line-height: 1.3;
  font-weight: 700;
  color: #111;
  margin: 0;

  word-break: break-word;
}

/*========================
  PRICE
=========================*/

.product-details .price {
  font-size: clamp(22px, 3vw, 32px);
  font-weight: 700;
  color: #000;
}

.product-details .compare-at-price {
  font-size: clamp(14px, 2vw, 18px);
  color: #888;
  text-decoration: line-through;
  margin-left: 10px;
}

/*========================
  DESCRIPTION
=========================*/

.product-details .product-description {
  font-size: clamp(14px, 2vw, 16px);
  line-height: 1.8;
  color: #555;
}

/*========================
  VARIANT SELECTOR
=========================*/

.product-details select {
  width: 100%;
  min-height: 52px;

  padding: 12px 16px;

  border: 1px solid #ddd;
  border-radius: 10px;

  background: #fff;

  font-size: clamp(14px, 2vw, 16px);

  outline: none;
  cursor: pointer;

  transition: 0.3s ease;
}

.product-details select:focus {
  border-color: #000;
}

/*========================
  QUANTITY SELECTOR
=========================*/

.quantity-selector {
  display: flex;
  align-items: center;
  gap: 12px;

  flex-wrap: wrap;
}

.quantity-selector input {
  width: 70px;
  min-height: 45px;

  text-align: center;

  border: 1px solid #ddd;
  border-radius: 8px;

  font-size: 15px;
}

/*========================
  BUTTONS
=========================*/

.add-to-cart-button,
.shopify-payment-button__button,
.size-btn {
  width: 100%;
  min-height: 54px;

  padding: 14px 18px;

  border-radius: 12px;

  font-size: clamp(14px, 2vw, 16px);
  font-weight: 600;

  cursor: pointer;

  transition: all 0.3s ease;

  text-align: center;

  overflow: hidden;
  white-space: normal;
  word-break: break-word;
}

/* ADD TO CART */

.add-to-cart-button {
  background: #000;
  color: #fff;
  border: none;
}

.add-to-cart-button:hover {
  background: #222;
  transform: translateY(-2px);
}

/* BUY NOW BUTTON */

.shopify-payment-button__button {
  background: #fff;
  color: #000;
  border: 1px solid #000;
}

.shopify-payment-button__button:hover {
  background: #000;
  color: #fff;
}

/* SIZE GUIDE BUTTON */

.size-btn {
  background: #fff;
  color: #000;
  border: 1px solid #000;
}

.size-btn:hover {
  background: #000;
  color: #fff;
}

/*========================
  INVENTORY STATUS
=========================*/

.inventory-status {
  font-size: 14px;
  color: green;
}

/*========================
  TRUST BADGES / ICONS
=========================*/

.payment-icons,
.trust-badges,
.product-icons {
  width: 100%;

  display: flex;
  flex-wrap: wrap;
  gap: 12px;

  align-items: center;
}

.payment-icons img,
.trust-badges img,
.product-icons img {
  width: auto;
  max-width: 55px;
  height: auto;
}

/*========================
  TABLE RESPONSIVE
=========================*/

table {
  width: 100%;
  display: block;
  overflow-x: auto;
}

/*========================
  TABLET RESPONSIVE
=========================*/

@media screen and (max-width: 991px) {

  .product-information {
    padding: 40px 18px;
  }

  .product-information__grid {
    grid-template-columns: 1fr;
    gap: 35px;
  }

  .product-details {
    gap: 20px;
  }
}

/*========================
  MOBILE RESPONSIVE
=========================*/

@media screen and (max-width: 767px) {

  html,
  body {
    overflow-x: hidden !important;
  }

  .product-information {
    padding: 25px 14px;
  }

  .product-information__grid {
    grid-template-columns: 1fr !important;
    gap: 25px;
  }

  .product-information__media {
    border-radius: 10px;
  }

  .product-information__media img {
    border-radius: 10px;
  }

  .product-details {
    gap: 18px;
  }

  /* Mobile Headings */

  .product-details h1 {
    font-size: 24px;
    line-height: 1.4;
  }

  /* Mobile Price */

  .product-details .price {
    font-size: 22px;
  }

  .product-details .compare-at-price {
    font-size: 14px;
  }

  /* Mobile Description */

  .product-details .product-description {
    font-size: 14px;
    line-height: 1.7;
  }

  /* Mobile Buttons */

  .add-to-cart-button,
  .shopify-payment-button__button,
  .size-btn {
    min-height: 50px;
    font-size: 14px;
    border-radius: 10px;
  }

  /* Prevent overflow from all children */

  .product-details *,
  .product-information__media *,
  .product-information * {
    max-width: 100%;
  }
}

/*========================
  EXTRA SMALL DEVICES
=========================*/

@media screen and (max-width: 480px) {

  .product-information {
    padding: 20px 10px;
  }

  .product-details {
    gap: 16px;
  }

  .product-details h1 {
    font-size: 21px;
  }

  .product-details .price {
    font-size: 19px;
  }

  .product-details .product-description {
    font-size: 13px;
  }

  .add-to-cart-button,
  .shopify-payment-button__button,
  .size-btn {
    min-height: 48px;
    font-size: 13px;
    padding: 12px;
  }

  .quantity-selector input {
    width: 60px;
  }
}{% endstylesheet %}

