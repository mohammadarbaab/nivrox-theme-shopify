            "custom_liquid_ewwemr": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "<!-- ORDER TRACKING (FULL CODE) -->\n<div class=\"order-tracking\">\n\n  <!-- Ordered -->\n  <div class=\"step\">\n    <div class=\"icon\">\n      <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"#FF8B8B\">\n        <path d=\"M6 2l1 4h10l1-4h2v2h-1l-2 12H7L5 4H4V2h2z\"/>\n      </svg>\n    </div>\n    <div class=\"label\">Ordered</div>\n    <div class=\"date\" id=\"ordered-date\"></div>\n  </div>\n\n  <div class=\"arrow\">→</div>\n\n  <!-- Shipped -->\n  <div class=\"step\">\n    <div class=\"icon\">\n      <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"#FF8B8B\">\n        <path d=\"M3 3h13v13H3V3zm13 3h3l2 3v7h-5V6zM5 18a2 2 0 104 0 2 2 0 00-4 0zm10 0a2 2 0 104 0 2 2 0 00-4 0z\"/>\n      </svg>\n    </div>\n    <div class=\"label\">Shipped</div>\n    <div class=\"date\" id=\"shipped-date\"></div>\n  </div>\n\n  <div class=\"arrow\">→</div>\n\n  <!-- Delivered -->\n  <div class=\"step\">\n    <div class=\"icon\">\n      <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"#FF8B8B\">\n        <path d=\"M3 3h18v18H3V3zm5 9l3 3 5-5-1.5-1.5L11 12l-1.5-1.5L8 12z\"/>\n      </svg>\n    </div>\n    <div class=\"label\">Delivered</div>\n    <div class=\"date\" id=\"delivered-date\"></div>\n  </div>\n\n</div>\n\n<style>\n.order-tracking {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  gap: 12px;\n  padding: 16px;\n  max-width: 900px;\n  margin: auto;\n  flex-wrap: nowrap;\n}\n\n.step {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  text-align: center;\n\n  padding: 14px 10px;\n  border: 1px solid #ff8b8b;\n  border-radius: 14px;\n  background: #fff;\n  min-width: 100px;\n  transition: 0.3s ease;\n}\n\n.step:hover {\n  transform: translateY(-3px);\n  box-shadow: 0 8px 18px rgba(255, 139, 139, 0.2);\n}\n\n.icon {\n  margin-bottom: 6px;\n}\n\n.label {\n  font-weight: 600;\n  font-size: 13px;\n  color: #111;\n}\n\n.date {\n  font-size: 12px;\n  color: #444;\n  margin-top: 2px;\n}\n\n.arrow {\n  font-size: 20px;\n  color: #999;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n/* 🔥 RESPONSIVE */\n@media (max-width: 600px) {\n  .order-tracking {\n    gap: 6px;\n    padding: 10px;\n  }\n\n  .step {\n    padding: 10px 6px;\n    min-width: 80px;\n  }\n\n  .label {\n    font-size: 11px;\n  }\n\n  .date {\n    font-size: 10px;\n  }\n\n  .arrow {\n    font-size: 14px;\n  }\n}\n</style>\n\n<script>\nfunction formatDate(date) {\n  return date.toLocaleDateString('en-US', {\n    month: 'short',\n    day: 'numeric'\n  });\n}\n\nconst today = new Date();\n\ndocument.getElementById('ordered-date').textContent = formatDate(today);\n\ndocument.getElementById('shipped-date').textContent =\n  formatDate(new Date(today.getTime() + 1 * 24 * 60 * 60 * 1000));\n\ndocument.getElementById('delivered-date').textContent =\n  formatDate(new Date(today.getTime() + 3 * 24 * 60 * 60 * 1000));\n</script>"
              },
              "blocks": {}
            },
