            "custom_liquid_mqJnWc": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "<div class=\"stock-widget\">\n\n  <div class=\"stock-header\">\n    <div>\n      <h4 class=\"stock-title\">SELLING OUT FAST</h4>\n      <p class=\"stock-subtitle\">Limited stock due to high demand</p>\n    </div>\n\n    <div class=\"stock-count\">\n      Only <span id=\"stock-left\">7</span> left in stock\n    </div>\n  </div>\n\n  <div class=\"progress-bar\">\n    <div class=\"progress-fill\" id=\"progress-fill\">\n      <span class=\"progress-text\" id=\"progress-text\"></span>\n    </div>\n  </div>\n\n</div>\n\n<style>\n/* MAIN CARD */\n.stock-widget{\n  max-width:600px;\n  margin:auto;\n  padding:12px;\n  font-family:system-ui, sans-serif;\n}\n\n/* HEADER */\n.stock-header{\n  display:flex;\n  justify-content:space-between;\n  align-items:flex-start;\n  gap:10px;\n  margin-bottom:8px;\n}\n\n/* TITLE PULSE */\n.stock-title{\n  font-size:14px;\n  font-weight:800;\n  margin:0;\n  color:black;\n}\n\n@keyframes pulseText{\n  0%{opacity:1}\n  50%{opacity:0.5}\n  100%{opacity:1}\n}\n\n.stock-subtitle{\n  font-size:12px;\n  color:#555;\n  margin:2px 0 0 0;\n}\n\n/* LIVE COUNT BOX */\n.stock-count{\n  font-size:12px;\n  font-weight:700;\n  background:#ffe5e5;\n  color:#b30000;\n  padding:6px 10px;\n  border-radius:6px;\n  white-space:nowrap;\n  animation:blink 1.2s infinite;\n}\n\n@keyframes blink{\n  0%{transform:scale(1)}\n  50%{transform:scale(1.05)}\n  100%{transform:scale(1)}\n}\n\n/* PROGRESS BAR */\n.progress-bar{\n  width:100%;\n  height:20px;\n  background:repeating-linear-gradient(\n    45deg,\n    #f6f6f6 0,\n    #f6f6f6 10px,\n    #e9e9e9 10px,\n    #e9e9e9 20px\n  );\n  border:1px solid #333;\n  border-radius:6px;\n  overflow:hidden;\n}\n\n.progress-fill{\n  height:100%;\n  width:0%;\n  background:linear-gradient(90deg,#ff2b2b,#b30000);\n  display:flex;\n  align-items:center;\n  transition:width 1.5s ease;\n  animation:urgencyGlow 2s infinite;\n}\n\n@keyframes urgencyGlow{\n  0%{filter:brightness(1)}\n  50%{filter:brightness(1.3)}\n  100%{filter:brightness(1)}\n}\n\n.progress-text{\n  color:#fff;\n  font-size:11px;\n  font-weight:700;\n  margin-left:8px;\n}\n\n/* RESPONSIVE */\n@media(max-width:600px){\n  .stock-header{\n    flex-direction:column;\n    align-items:flex-start;\n  }\n\n  .stock-count{\n    align-self:flex-end;\n  }\n}\n</style>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", () => {\n\n  const fill = document.getElementById(\"progress-fill\");\n  const text = document.getElementById(\"progress-text\");\n  const stockLeft = document.getElementById(\"stock-left\");\n\n  let stock = 7;        // 🔴 initial stock\n  let sold = 65;        // progress %\n\n  function updateUI(){\n    fill.style.width = sold + \"%\";\n    text.textContent = sold + \"% SOLD\";\n    stockLeft.textContent = stock;\n  }\n\n  function simulateSales(){\n    if(stock > 1){\n      stock -= 1;\n      sold += 1;\n    } else {\n      stock = 7;\n      sold = 65;\n    }\n    updateUI();\n  }\n\n  updateUI();\n\n  // 🔥 fast urgency updates\n  setInterval(simulateSales, 15000);\n\n});\n</script>"
              },
              "blocks": {}
            },
