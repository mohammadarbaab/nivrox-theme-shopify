            "custom_liquid_ewwemr": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "<!-- Order Tracking Section -->\n<div class=\"order-tracking\">\n  \n  <!-- Ordered -->\n  <div class=\"step\">\n    <div class=\"icon\">\n      <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"#FF8B8B\">\n        <path d=\"M6 2l1 4h10l1-4h2v2h-1l-2 12H7L5 4H4V2h2z\"/>\n      </svg>\n    </div>\n    <div class=\"label\">Ordered</div>\n    <div class=\"date\" id=\"ordered-date\"></div>\n  </div>\n\n  <div class=\"arrow\">»</div>\n\n  <!-- Shipped -->\n  <div class=\"step\">\n    <div class=\"icon\">\n      <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"#FF8B8B\">\n        <path d=\"M3 3h13v13H3V3zm13 3h3l2 3v7h-5V6zM5 18a2 2 0 104 0 2 2 0 00-4 0zm10 0a2 2 0 104 0 2 2 0 00-4 0z\"/>\n      </svg>\n    </div>\n    <div class=\"label\">Shipped</div>\n    <div class=\"date\" id=\"shipped-date\"></div>\n  </div>\n\n  <div class=\"arrow\">»</div>\n\n  <!-- Delivered -->\n  <div class=\"step\">\n    <div class=\"icon\">\n      <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"#FF8B8B\">\n        <path d=\"M3 3h18v18H3V3zm5 9l3 3 5-5-1.5-1.5L11 12l-1.5-1.5L8 12z\"/>\n      </svg>\n    </div>\n    <div class=\"label\">Delivered</div>\n    <div class=\"date\" id=\"delivered-date\"></div>\n  </div>\n\n</div>\n\n<!-- Styling -->\n<style>\n.order-tracking {\n  display: flex;\n  justify-content: center;   /* center align */\n  align-items: center;\n  gap: 10px;\n  padding: 10px;\n  width: fit-content;        /* important */\n  margin: 0 auto;            /* center pura block */\n}\n.step {\n  flex: 1;\n  text-align: center;\n  padding: 10px;\n  border: 1px solid #FF8B8B;\n  border-radius: 10px;\n}\n\n.icon {\n  margin-bottom: 5px;\n}\n\n.label {\n  font-weight: 600;\n  font-size: 14px;\n  margin-bottom: 4px;\n  color: #121212;\n}\n\n.date {\n  font-size: 13px;\n  color: #121212;\n}\n\n.arrow {\n  font-size: 24px;\n  color: #494949;\n}\n</style>\n\n<!-- Date Logic -->\n<script>\nfunction formatDate(date) {\n  const options = { month: 'short', day: 'numeric' };\n  return date.toLocaleDateString('en-US', options);\n}\n\nconst today = new Date();\n\nconst shippedDateObj = new Date();\nshippedDateObj.setDate(today.getDate() + 1);\n\nconst deliveredDateObj = new Date();\ndeliveredDateObj.setDate(today.getDate() + 3);\n\ndocument.getElementById('ordered-date').textContent = formatDate(today);\ndocument.getElementById('shipped-date').textContent = formatDate(shippedDateObj);\ndocument.getElementById('delivered-date').textContent = formatDate(deliveredDateObj);\n</script>"
              },
